generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  email     String   @unique
  password  String
  role      String   // ADMIN | COMPANY | STUDENT
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  student Student?
  company Company?
}

model Student {
  id             String  @id @default(cuid())
  userId         String  @unique
  fullName       String
  phone          String  @default("")
  department     String  @default("")
  cgpa           Float   @default(0)
  skills         String  @default("")
  resumeFilename String?
  isBlacklisted  Boolean @default(false)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]
}

model Company {
  id             String  @id @default(cuid())
  userId         String  @unique
  companyName    String
  industry       String  @default("")
  hrContact      String  @default("")
  website        String  @default("")
  approvalStatus String  @default("PENDING") // PENDING | APPROVED | REJECTED
  isBlacklisted  Boolean @default(false)

  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  drives PlacementDrive[]
}

model PlacementDrive {
  id                  String   @id @default(cuid())
  companyId           String
  jobTitle            String
  jobDescription      String   @default("")
  eligibilityCriteria String   @default("")
  requiredSkills      String   @default("")
  experienceRequired  String   @default("")
  salaryRange         String   @default("")
  deadline            DateTime
  status              String   @default("OPEN") // OPEN | CLOSED
  createdAt           DateTime @default(now())

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications Application[]
}

model Application {
  id        String   @id @default(cuid())
  studentId String
  driveId   String
  appliedAt DateTime @default(now())
  status    String   @default("APPLIED") // APPLIED | SHORTLISTED | INTERVIEW | SELECTED | PLACED

  student Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  drive   PlacementDrive @relation(fields: [driveId], references: [id], onDelete: Cascade)

  @@unique([studentId, driveId])
}
